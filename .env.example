DISCORD_WEBHOOK_URL=
BEZREALITKY_WEBHOOK_URL=
SOLD_WEBHOOK_URL=
IDNES_WEBHOOK_URL=
BAZOS_WEBHOOK_URL=
# Discord bot (soukromý kanál na uživatele). Invite s Manage Channels + Manage Webhooks:
# https://discord.com/oauth2/authorize?client_id=CLIENT_ID&permissions=536890384&scope=bot%20applications.commands
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_SERVER_INVITE=
SEARCH_URL=https://www.sreality.cz/hledani/pronajem/byty/praha-1,praha-2,praha-3,praha-4,praha-6,praha-7,praha-8,praha-9?velikost=2%2B1%2C2%2Bkk%2C3%2B1%2C3%2Bkk%2C4%2B1%2C4%2Bkk%2C5%2B1%2C5%2Bkk&razeni=nejlevnejsi&cena-do=25759&plocha-od=45
POLL_INTERVAL_SEC=60
POLL_PAGES=2
HOST=127.0.0.1
PORT=8080
UPDATE_FEED=github:Freshsole/RealityScraper
UPDATE_TOKEN=
AUTO_UPDATE=1
GOOGLE_MAPS_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8080
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:ahoj@realitify.cz
# Amazon SES (SMTP rozhraní, region eu-central-1): viz docs/emailing-ses.md
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
# SES SMTP username (začíná AKIA…) a SMTP password (odvozené z IAM klíče, ne secret key)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Realitify <noreply@realitify.cz>
SMTP_STARTTLS=1
# Volitelně: configuration set (události bounce/complaint/delivery) a ochrana SNS webhooku
SES_CONFIGURATION_SET=
# SES_WEBHOOK_TOKEN: náhodný řetězec do SNS subscription URL jako ?token=; SES_SNS_TOPIC_ARN: ARN topicu
# (více oddělených čárkou). Aspoň jedno z nich je povinné, jinak webhook vrací 503.
SES_WEBHOOK_TOKEN=
SES_SNS_TOPIC_ARN=
# Limity odesílání (SES sandbox: 1/s, production: dle kvóty; 0 = bez omezení)
EMAIL_MAX_PER_SEC=10
EMAIL_MAX_PER_HOUR=0
# Odesílatelé podle streamu (prázdné = noreply@/alerty@/tym@ na doméně SMTP_FROM)
EMAIL_FROM_TRANSACTIONAL=Realitify <noreply@realitify.cz>
EMAIL_FROM_ALERTS=Realitify <alerty@realitify.cz>
EMAIL_FROM_LIFECYCLE=Realitify <ahoj@realitify.cz>
EMAIL_REPLY_TO=podpora@realitify.cz
# EMAIL_ONLY_TRANSACTIONAL=1  # dočasně: odchází jen transakční e-maily (účet, platby); alerty, lifecycle a kampaně se přeskočí, v appce se zobrazí upozornění
# EMAIL_AUTOMATION=1   # 0 vypne frontu a automatické e-maily
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=cs
WHATSAPP_BUSINESS_NUMBER=
ADMIN_EMAIL=admin@realitify.cz
ADMIN_PASSWORD=
# Na Railway: Volume mount /data (Railway pak nastaví RAILWAY_VOLUME_MOUNT_PATH)
DATA_DIR=
